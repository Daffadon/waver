# Waver global env template. Copy to .env, set values, never commit secrets.
# Backend reads .env from repo root. Real env vars win over these.
PORT=8080
TCP_PORT=9090
DB_PATH=./data/waver.db
JWT_SECRET=change-me-to-a-long-random-secret

# Cluster. All optional: leave PEERS empty and this stays a single node.
# NODE_ID is this node's identity in every clock. Generated and stored on first
# boot when unset. Every node in a mesh needs its own.
# NODE_ID=node-1
# PEERS lists the other nodes' TCP ports. Never list this node itself.
# PEERS=10.0.0.2:9090,10.0.0.3:9090
# SYNC_SECRET authenticates peer frames. Defaults to JWT_SECRET.
# SYNC_SECRET=change-me-too
# SYNC_INTERVAL_MS is the anti-entropy digest round with each peer.
SYNC_INTERVAL_MS=1000
# CACHE_MB is the fastcache arena backing the flag read path.
CACHE_MB=64
